  "grammar_note": {
    "title": {
      "en": "Grammar: dass-clauses for opinions",
      "te": "వ్యాకరణం: అభిప్రాయాలకు dass-వాక్యం",
      "hi": "व्याकरण: राय के लिए dass-वाक्य"
    },
    "body": {
      "en": "After \"Ich finde, dass …\" or \"Ich glaube, dass …\" the verb goes to the end: Ich finde, dass er recht hat. \"Gefallen\" uses dative: Mir gefällt das.",
      "te": "\"Ich finde, dass …\" తర్వాత క్రియ చివర: Ich finde, dass er recht hat. \"gefallen\" డేటివ్: Mir gefällt das.",
      "hi": "\"Ich finde, dass …\" के बाद क्रिया अंत में: Ich finde, dass er recht hat। \"gefallen\" dative लेता है: Mir gefällt das।"
    }
  },
  "deep_dive": {
    "en": "\"Ich mag\" and \"Ich liebe\" are stronger than \"gefallen\". \"Mir gefällt\" is a gentle, polite way to say you like something.",
    "te": "\"Ich mag\" మరియు \"Ich liebe\" \"gefallen\" కంటే బలమైనవి. \"Mir gefällt\" మృదువైన, మర్యాదపూర్వక మార్గం.",
    "hi": "\"Ich mag\" और \"Ich liebe\" \"gefallen\" से ज़्यादा मज़बूत हैं। \"Mir gefällt\" नरम और विनम्र तरीका है।"
  },
  "common_mistakes": [
    {
      "wrong": "Ich finde, er ist recht hat.",
      "right": "Ich finde, dass er recht hat.",
      "why": {
        "en": "After dass the verb goes to the end.",
        "te": "dass తర్వాత క్రియ చివర.",
        "hi": "dass के बाद क्रिया अंत में।"
      }
    },
    {
      "wrong": "Ich gefällt das.",
      "right": "Mir gefällt das.",
      "why": {
        "en": "gefallen uses dative.",
        "te": "gefallen కి డేటివ్.",
        "hi": "gefallen के साथ dative।"
      }
    }
  ],
  "cultural_note": {
    "en": "Germans value direct, honest opinions. Disagreeing politely is normal and seen as respectful when you give a reason.",
    "te": "జర్మన్లు సూటిగా, నిజాయితీగా అభిప్రాయం చెప్పడాన్ని ఇష్టపడతారు. కారణంతో మర్యాదగా విభేదించడం గౌరవం.",
    "hi": "जर्मन सीधी और ईमानदार राय पसंद करते हैं। कारण के साथ विनम्रता से असहमत होना सम्मान माना जाता है।"
  },
