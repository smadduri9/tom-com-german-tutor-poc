  "grammar_note": {
    "title": {
      "en": "Grammar: accusative for movement, dative for place",
      "te": "వ్యాకరణం: గతికి accusative, స్థానానికి dative",
      "hi": "व्याकरण: गति के लिए accusative, स्थान के लिए dative"
    },
    "body": {
      "en": "Movement (wohin?): accusative. Ich lege das Buch auf den Tisch. Position (wo?): dative. Das Buch liegt auf dem Tisch. Lege/liege, stelle/stehe, setze/sitze follow the same rule.",
      "te": "గతి (wohin?): accusative. Ich lege das Buch auf den Tisch. స్థానం (wo?): dative. Das Buch liegt auf dem Tisch.",
      "hi": "गति (wohin?): accusative। Ich lege das Buch auf den Tisch। स्थिति (wo?): dative। Das Buch liegt auf dem Tisch।"
    }
  },
  "deep_dive": {
    "en": "Use legen (put) and liegen (lie) for flat objects; stellen (stand upright) and stehen; setzen (seat) and sitzen. Mixing them is a very common mistake.",
    "te": "సపాటి వస్తువులకు legen/liegen; నిలబెట్టే వస్తువులకు stellen/stehen; కూర్చోబెట్టడానికి setzen/sitzen. వీటిని కలపడం సాధారణ తప్పు.",
    "hi": "चपटी चीज़ों के लिए legen/liegen; खड़ी चीज़ों के लिए stellen/stehen; बैठाने के लिए setzen/sitzen। इन्हें मिलाना आम गलती है।"
  },
  "common_mistakes": [
    {
      "wrong": "Das Buch liegt auf den Tisch.",
      "right": "Das Buch liegt auf dem Tisch.",
      "why": {
        "en": "Position: dative (dem).",
