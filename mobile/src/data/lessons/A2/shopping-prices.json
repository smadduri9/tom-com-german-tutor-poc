  "grammar_note": {
    "title": {
      "en": "Grammar: Preis and price words",
      "te": "వ్యాకరణం: ధర పదాలు",
      "hi": "व्याकरण: कीमत के शब्द"
    },
    "body": {
      "en": "\"Was kostet …?\" asks the price. In German numbers with decimals use a comma: 4,50 Euro. \"Das macht …\" means \"That comes to …\" at a till.",
      "te": "\"Was kostet …?\" ధర అడుగుతుంది. దశాంశానికి కామా: 4,50 Euro. \"Das macht …\" అంటే \"మొత్తం …\".",
      "hi": "\"Was kostet …?\" कीमत पूछता है। दशमलव में कॉमा: 4,50 Euro। \"Das macht …\" यानी \"कुल …\"।"
    }
  },
  "deep_dive": {
    "en": "German shops often close on Sundays and public holidays. Many shops use \"Kassenbon\" and ask if you want it. Small shops may not take cards, so keep some cash.",
    "te": "జర్మన్ దుకాణాలు తరచుగా ఆదివారాలు, సెలవు రోజుల్లో మూసి ఉంటాయి. కొన్ని చిన్న దుకాణాలు కార్డ్ తీసుకోవు; కొంత నగదు ఉంచుకోండి.",
    "hi": "जर्मन दुकानें अक्सर रविवार और छुट्टियों पर बंद रहती हैं। छोटी दुकानें कार्ड न लें, इसलिए कुछ नकद रखें।"
  },
  "common_mistakes": [
    {
      "wrong": "vier Komma fünf Euro",
      "right": "vier Euro fünfzig",
      "why": {
        "en": "Everyday prices are said as Euro and cents.",
        "te": "రోజువారీ ధరలను యూరో, సెంట్లుగా చెబుతారు.",
        "hi": "रोज़मर्रा की कीमतें यूरो और सेंट में बोली जाती हैं।"
      }
    },
    {
      "wrong": "Ich will kaufen Brot.",
      "right": "Ich möchte Brot kaufen.",
      "why": {
