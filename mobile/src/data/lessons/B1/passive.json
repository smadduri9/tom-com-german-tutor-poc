  "grammar_note": {
    "title": {
      "en": "Grammar: werden + past participle",
      "te": "వ్యాకరణం: werden + past participle",
      "hi": "व्याकरण: werden + past participle"
    },
    "body": {
      "en": "Present passive: wird + participle (Das Haus wird gebaut). Past: wurde (Das Haus wurde gebaut). Perfect: ist/sind … worden (Die Tür ist repariert worden). The agent uses von (by a person) or durch (by a means).",
      "te": "వర్తమానం: wird + participle. గతం: wurde. Perfekt: ist … worden. కర్త: von (వ్యక్తి చేత), durch (ద్వారా).",
      "hi": "वर्तमान: wird + participle। भूत: wurde। Perfekt: ist … worden। कर्ता: von (व्यक्ति द्वारा), durch (ज़रिए से)।"
    }
  },
  "deep_dive": {
    "en": "Use the passive when the doer is unknown or unimportant: Hier wird Deutsch gesprochen. Modal verbs add the passive infinitive: Die Tür muss repariert werden.",
    "te": "కర్త తెలియకపోయినా లేదా ముఖ్యం కాకపోయినా కర్మణి వాడండి. మోడల్ క్రియలతో: Die Tür muss repariert werden.",
    "hi": "कर्ता अज्ञात या गौण हो तो कर्मवाच्य: Hier wird Deutsch gesprochen। मोडल के साथ: Die Tür muss repariert werden।"
  },
  "common_mistakes": [
    {
      "wrong": "Die Tür wird repariert worden.",
      "right": "Die Tür ist repariert worden.",
      "why": {
        "en": "Perfect passive uses sein + worden.",
        "te": "Perfekt కర్మణి sein + worden.",
        "hi": "Perfekt कर्मवाच्य sein + worden।"
      }
    },
    {
      "wrong": "Das Haus wird von gebaut.",
      "right": "Das Haus wird gebaut.",
      "why": {
        "en": "Do not add von without an agent.",
        "te": "కర్త లేకుండా von వద్దు.",
        "hi": "कर्ता के बिना von नहीं।"
      }
    }
  ],
  "cultural_note": {
    "en": "In German official notices passive forms are everywhere: \"Hier wird nicht geraucht\" (smoking is not allowed here). Learn to read them.",
    "te": "జర్మన్ నోటీసుల్లో కర్మణి సాధారణం: \"Hier wird nicht geraucht\" (ఇక్కడ పొగ తాగకూడదు). వీటిని చదవడం నేర్చుకోండి.",
    "hi": "जर्मन सूचनाओं में कर्मवाच्य आम है: \"Hier wird nicht geraucht\" (यहाँ धूम्रपान मना है)। इन्हें पढ़ना सीखें।"
  },
  "practice_tip": {
    "en": "Find three notices in German around you and identify the passive in each.",
    "te": "మీ చుట్టూ మూడు జర్మన్ నోటీసులు చూసి ప్రతిదానిలో కర్మణి గుర్తించండి.",
    "hi": "अपने आसपास तीन जर्मन सूचनाएँ ढूँढें और हर एक में कर्मवाच्य पहचानें।"
  },
