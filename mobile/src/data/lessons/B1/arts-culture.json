  "grammar_note": {
    "title": {
      "en": "Grammar: opinions in the past",
      "te": "వ్యాకరణం: గత కాలంలో అభిప్రాయాలు",
      "hi": "व्याकरण: अतीत में राय"
    },
    "body": {
      "en": "Use Präteritum for past opinions in writing (fand, war) and Perfekt in speech (ich habe es gefunden). \"Das hat mich begeistert\" uses an accusative pronoun: mich, dich, uns.",
      "te": "గత అభిప్రాయాలకు రాతలో Präteritum (fand, war), మాటల్లో Perfekt. \"Das hat mich begeistert\" లో mich, dich, uns.",
      "hi": "अतीत की राय लिखित में Präteritum (fand, war) और बोलचाल में Perfekt। \"Das hat mich begeistert\" में mich, dich, uns।"
    }
  },
  "deep_dive": {
    "en": "German culture values art and public festivals. Many cities offer free concerts in summer, and museums often have free days. Ask locals where to go; they usually know the best events.",
    "te": "జర్మన్ సంస్కృతిలో కళలు, ప్రజా ఉత్సవాలు ముఖ్యం. వేసవిలో చాలా నగరాల్లో ఉచిత కచేరీలు, మ్యూజియంలకు ఉచిత రోజులు ఉంటాయి.",
    "hi": "जर्मन संस्कृति में कला और सार्वजनिक त्योहार महत्वपूर्ण हैं। गर्मियों में कई शहरों में मुफ़्त संगीत और संग्रहालयों में मुफ़्त दिन होते हैं।"
  },
  "common_mistakes": [
    {
      "wrong": "Das Konzert hat mir gefallen gut.",
      "right": "Das Konzert hat mir gut gefallen.",
      "why": {
        "en": "gefallen takes dative; place gut before the verb.",
        "te": "gefallen డేటివ్; gut ను క్రియకు ముందు.",
        "hi": "gefallen के साथ dative; gut क्रिया से पहले।"
      }
    },
    {
      "wrong": "Die Ausstellung ist offen bis Mai.",
      "right": "Die Ausstellung ist bis Mai geöffnet.",
      "why": {
        "en": "Use geöffnet for open.",
        "te": "open కి geöffnet.",
        "hi": "open के लिए geöffnet।"
      }
    }
  ],
  "cultural_note": {
    "en": "Germany has many free or cheap cultural events. Many people attend local festivals (Stadtfest) in summer, and small talk often starts with \"Was machen Sie in Ihrer Freizeit?\"",
    "te": "జర్మనీలో అనేక ఉచిత లేదా చౌక సాంస్కృతిక కార్యక్రమాలు ఉన్నాయి. చిన్న సంభాషణ తరచుగా \"Was machen Sie in Ihrer Freizeit?\" తో మొదలవుతుంది.",
    "hi": "जर्मनी में कई मुफ़्त या सस्ते सांस्कृतिक कार्यक्रम हैं। बातचीत अक्सर \"Was machen Sie in Ihrer Freizeit?\" से शुरू होती है।"
  },
  "practice_tip": {
    "en": "Describe the last film or concert you saw, with one opinion and one reason.",
    "te": "మీరు చూసిన చివరి సినిమా లేదా కచేరీని ఒక అభిప్రాయం, ఒక కారణంతో వివరించండి.",
    "hi": "आपने जो आख़िरी फ़िल्म या कॉन्सर्ट देखा उसे एक राय और एक कारण के साथ बताएँ।"
  },
