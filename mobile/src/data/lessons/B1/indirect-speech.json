  "grammar_note": {
    "title": {
      "en": "Grammar: Konjunktiv I",
      "te": "వ్యాకరణం: Konjunktiv I",
      "hi": "व्याकरण: Konjunktiv I"
    },
    "body": {
      "en": "Konjunktiv I uses the stem plus endings: er sei (sein), er habe (haben), er komme. For reporting use the third person; if it looks like the indicative, use Konjunktiv II instead: sie kämen, er wäre.",
      "te": "Konjunktiv I: మూలం + ముగింపు: er sei (sein), er habe (haben), er komme. మూడవ వ్యక్తి. సాధారణ రూపంలా ఉంటే Konjunktiv II.",
      "hi": "Konjunktiv I: मूल + अंत: er sei (sein), er habe (haben), er komme। तीसरा पुरुष। सामान्य रूप जैसा लगे तो Konjunktiv II।"
    }
  },
  "deep_dive": {
    "en": "Indirect speech is common in news and formal reports. In everyday talk, Germans often use the indicative or würde + infinitive: Er sagt, er würde kommen.",
    "te": "వార్తలు, అధికారిక నివేదికలలో పరోక్ష ప్రసంగం సాధారణం. రోజువారీ మాటల్లో indicative లేదా würde + మూల క్రియ.",
    "hi": "समाचार और औपचारिक रिपोर्ट में परोक्ष कथन आम है। रोज़ाना बोलचाल में indicative या würde + मूल क्रिया।"
  },
  "common_mistakes": [
    {
      "wrong": "Er sagt, er ist krank.",
      "right": "Er sagt, er sei krank.",
      "why": {
        "en": "Reported speech uses Konjunktiv I.",
        "te": "నివేదికకు Konjunktiv I.",
        "hi": "रिपोर्ट के लिए Konjunktiv I।"
      }
    },
    {
      "wrong": "Sie fragte, ob ich komme morgen.",
      "right": "Sie fragte, ob ich morgen komme.",
      "why": {
        "en": "Verb goes to the end after ob.",
        "te": "ob తర్వాత క్రియ చివర.",
        "hi": "ob के बाद क्रिया अंत में।"
      }
    }
  ],
  "cultural_note": {
    "en": "In German news, reporters use Konjunktiv I to keep distance: \"Der Minister sagte, die Lage sei ernst.\" This signals that the claim is not their own.",
    "te": "జర్మన్ వార్తల్లో Konjunktiv I వాడి, ఆ మాట తమది కాదని చూపిస్తారు.",
    "hi": "जर्मन समाचार में Konjunktiv I से दिखाते हैं कि बात उनकी अपनी नहीं है।"
  },
