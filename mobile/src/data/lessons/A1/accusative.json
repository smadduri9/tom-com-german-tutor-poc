  "grammar_note": {
    "title": {
      "en": "Grammar: accusative articles",
      "te": "వ్యాకరణం: కర్మ ఆర్టికల్స్",
      "hi": "व्याकरण: कर्म के आर्टिकल"
    },
    "body": {
      "en": "Only der words change in the accusative: der → den, ein → einen. Die and das stay the same: die → die, das → das, eine → eine, ein → ein.",
      "te": "కర్మలో der పదాలు మాత్రమే మారతాయి: der → den, ein → einen. die, das మారవు.",
      "hi": "कर्म में केवल der शब्द बदलते हैं: der → den, ein → einen। die और das नहीं बदलते।"
    }
  },
  "deep_dive": {
    "en": "Ask who or what is the object with \"Wen?\" (whom) or \"Was?\" (what): Ich sehe wen? den Mann. Ich sehe was? das Auto.",
    "te": "కర్మను \"Wen?\" (ఎవరిని) లేదా \"Was?\" (దేనిని) తో అడగండి: Ich sehe wen? den Mann.",
    "hi": "कर्म को \"Wen?\" (किसे) या \"Was?\" (क्या) से पूछें: Ich sehe wen? den Mann।"
  },
  "common_mistakes": [
    {
      "wrong": "Ich kaufe der Fahrschein.",
      "right": "Ich kaufe den Fahrschein.",
      "why": {
        "en": "Object of kaufen takes den.",
        "te": "kaufen కర్మకు den.",
        "hi": "kaufen का कर्म: den।"
      }
    },
    {
      "wrong": "Ich brauche ein Stift.",
      "right": "Ich brauche einen Stift.",
      "why": {
        "en": "der word: ein → einen.",
        "te": "der పదం: ein → einen.",
        "hi": "der शब्द: ein → einen।"
      }
    }
  ],
  "cultural_note": {
    "en": "In shops and at ticket counters Germans ask \"Was darf es sein?\" (What may it be?). Answer with \"Ich nehme …\" or \"Ich hätte gern …\".",
    "te": "దుకాణాలలో \"Was darf es sein?\" అని అడుగుతారు. జవాబు: \"Ich nehme …\" లేదా \"Ich hätte gern …\".",
    "hi": "दुकानों में \"Was darf es sein?\" पूछा जाता है। जवाब: \"Ich nehme …\" या \"Ich hätte gern …\"।"
  },
  "practice_tip": {
    "en": "Say what you buy today in German with den or einen.",
    "te": "ఈ రోజు మీరు కొన్నవి den లేదా einen తో జర్మన్‌లో చెప్పండి.",
    "hi": "आज आपने जो खरीदा उसे den या einen के साथ जर्मन में बताएँ।"
  },
