  "grammar_note": {
    "title": {
      "en": "Grammar: modal verbs",
      "te": "వ్యాకరణం: మోడల్ క్రియలు",
      "hi": "व्याकरण: मोडल क्रियाएँ"
    },
    "body": {
      "en": "The modal takes the conjugated form (ich kann, du kannst, er kann, wir können). The main verb goes to the end of the sentence in its infinitive: Ich kann gut Deutsch sprechen.",
      "te": "మోడల్ క్రియ రూపం మారుతుంది (ich kann, du kannst). ప్రధాన క్రియ వాక్యం చివర మూల రూపంలో: Ich kann gut Deutsch sprechen.",
      "hi": "मोडल क्रिया अपना रूप बदलती है (ich kann, du kannst)। मुख्य क्रिया मूल रूप में वाक्य के अंत में जाती है: Ich kann gut Deutsch sprechen।"
    }
  },
  "deep_dive": {
    "en": "Können = can, wollen = want, müssen = must, dürfen = may. Möchte is a softer form of want, good for polite requests: Ich möchte bitte einen Tee.",
    "te": "können = can, wollen = want, müssen = must, dürfen = may. möchte మరింత మర్యాదపూర్వకమైన \"కావాలి\": Ich möchte bitte einen Tee.",
    "hi": "können = can, wollen = want, müssen = must, dürfen = may। möchte नरम और विनम्र \"चाहिए\" है: Ich möchte bitte einen Tee।"
  },
  "common_mistakes": [
    {
      "wrong": "Ich kann Deutsch sprechen.",
      "right": "Ich kann Deutsch sprechen.",
      "why": {
        "en": "Correct. Infinitive at the end.",
        "te": "సరైనది. మూల రూపం చివర.",
        "hi": "सही है। मूल रूप अंत में।"
      }
    },
    {
      "wrong": "Ich muss gehe.",
      "right": "Ich muss gehen.",
      "why": {
        "en": "After a modal, use the infinitive.",
        "te": "మోడల్ తర్వాత మూల రూపం.",
        "hi": "मोडल के बाद मूल रूप।"
      }
    }
  ],
  "cultural_note": {
    "en": "Germans often use \"Ich möchte …\" in shops and restaurants. It is the polite way to ask for something.",
    "te": "జర్మన్లు దుకాణాలు, రెస్టారెంట్లలో \"Ich möchte …\" అంటారు. ఇది మర్యాదపూర్వక మార్గం.",
    "hi": "जर्मन लोग दुकानों और रेस्तराँ में \"Ich möchte …\" कहते हैं। यह विनम्र तरीका है।"
  },
