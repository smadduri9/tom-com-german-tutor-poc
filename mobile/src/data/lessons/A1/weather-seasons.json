  "grammar_note": {
    "title": {
      "en": "Grammar: im + season",
      "te": "వ్యాకరణం: im + ఋతువు",
      "hi": "व्याकरण: im + ऋतु"
    },
    "body": {
      "en": "Use im with seasons: im Winter, im Sommer, im Frühling, im Herbst. For weather, use \"Es ist …\" with an adjective (Es ist kalt) or \"Es regnet / schneit\".",
      "te": "ఋతువులకు im: im Winter, im Sommer. వాతావరణానికి \"Es ist …\" + విశేషణం (Es ist kalt) లేదా \"Es regnet / schneit\".",
      "hi": "ऋतुओं के लिए im: im Winter, im Sommer। मौसम के लिए \"Es ist …\" + विशेषण (Es ist kalt) या \"Es regnet / schneit\"।"
    }
  },
  "deep_dive": {
    "en": "German weather talk is often polite small talk. \"Schönes Wetter, nicht wahr?\" (Nice weather, isn't it?) is a common opening.",
    "te": "జర్మన్ వాతావరణ మాటలు మర్యాదపూర్వక చిన్న సంభాషణ. \"Schönes Wetter, nicht wahr?\" సాధారణ మొదలు మాట.",
    "hi": "जर्मन मौसम की बातें विनम्र छोटी बातचीत है। \"Schönes Wetter, nicht wahr?\" आम शुरुआत है।"
  },
  "common_mistakes": [
    {
      "wrong": "Es ist regnet.",
      "right": "Es regnet.",
      "why": {
        "en": "Use \"Es regnet\", no \"ist\".",
        "te": "\"Es regnet\" వాడండి, \"ist\" వద్దు.",
        "hi": "\"Es regnet\" लिखें, \"ist\" नहीं।"
      }
    },
    {
      "wrong": "im Frühling ist kalt",
      "right": "Es ist im Frühling kalt.",
      "why": {
        "en": "Word order: time and subject come before the adjective.",
        "te": "క్రమం: సమయం, విషయం విశేషణం ముందు.",
        "hi": "क्रम: समय और विषय विशेषण से पहले।"
      }
    }
  ],
  "cultural_note": {
    "en": "Germans talk about the weather constantly. Saying \"Schönen Tag noch!\" (Have a nice day) is a common parting phrase.",
    "te": "జర్మన్లు వాతావరణం గురించి తరచుగా మాట్లాడతారు. \"Schönen Tag noch!\" సాధారణ వీడ్కోలు.",
    "hi": "जर्मन लोग मौसम की बात बार-बार करते हैं। \"Schönen Tag noch!\" आम विदाई वाक्य है।"
  },
  "practice_tip": {
    "en": "Each morning this week, say the weather aloud in German.",
    "te": "ఈ వారం ప్రతి ఉదయం వాతావరణాన్ని జర్మన్‌లో గట్టిగా చెప్పండి.",
    "hi": "इस हफ़्ते हर सुबह मौसम जर्मन में ज़ोर से बताएँ।"
  },
