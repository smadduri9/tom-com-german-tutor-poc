  "grammar_note": {
    "title": {
      "en": "Grammar: comparison",
      "te": "వ్యాకరణం: తులనం",
      "hi": "व्याकरण: तुलना"
    },
    "body": {
      "en": "Comparative: add -er (schnell → schneller). Superlative: am + -sten (am schnellsten) or der/die/das + -ste (der größte). Use als for \"than\" and so … wie for \"as … as\".",
      "te": "తులనార్థకం: -er (schnell → schneller). అత్యుత్తమం: am + -sten (am schnellsten). \"than\" కి als, \"as … as\" కి so … wie.",
      "hi": "तुलनात्मक: -er (schnell → schneller)। उत्तमावस्था: am + -sten (am schnellsten)। \"than\" के लिए als, \"as … as\" के लिए so … wie।"
    }
  },
  "deep_dive": {
    "en": "Some adjectives change their vowel: groß → größer → der größte; alt → älter → der älteste. Irregular: gut → besser → am besten; viel → mehr → am meisten.",
    "te": "కొన్ని విశేషణాల అచ్చు మారుతుంది: groß → größer → der größte; alt → älter. క్రమరహితం: gut → besser → am besten.",
    "hi": "कुछ विशेषणों का स्वर बदलता है: groß → größer → der größte; alt → älter। अनियमित: gut → besser → am besten।"
  },
  "common_mistakes": [
    {
      "wrong": "schneller als wie",
      "right": "schneller als",
      "why": {
        "en": "Use either als or wie, not both.",
        "te": "als లేదా wie, రెండూ కాదు.",
        "hi": "als या wie, दोनों नहीं।"
      }
    },
    {
      "wrong": "Der Zug ist am schnellere.",
      "right": "Der Zug ist am schnellsten.",
      "why": {
        "en": "Superlative after am: -sten.",
        "te": "am తర్వాత -sten.",
        "hi": "am के बाद -sten।"
      }
    }
  ],
  "cultural_note": {
    "en": "Germans value directness in comparisons, but they usually avoid strong praise. \"Gut\" is a common, polite evaluation.",
    "te": "జర్మన్లు పోలికల్లో సూటిగా ఉంటారు, కానీ అతిగా పొగడరు. \"Gut\" సాధారణ, మర్యాదపూర్వక మాట.",
    "hi": "जर्मन तुलना में सीधे होते हैं, पर बहुत ज़्यादा तारीफ़ नहीं करते। \"Gut\" आम और विनम्र राय है।"
  },
