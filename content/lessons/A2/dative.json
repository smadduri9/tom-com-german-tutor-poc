  "grammar_note": {
    "title": {
      "en": "Grammar: dative articles",
      "te": "వ్యాకరణం: డేటివ్ ఆర్టికల్స్",
      "hi": "व्याकरण: डेटिव आर्टिकल"
    },
    "body": {
      "en": "Dative: der → dem, die → der, das → dem, die (plural) → den. Ein → einem, eine → einer. Dative pronouns: mir, dir, ihm, ihr, uns, euch, ihnen, Ihnen.",
      "te": "డేటివ్: der → dem, die → der, das → dem, బహువచనం → den. ein → einem, eine → einer. సర్వనామాలు: mir, dir, ihm, ihr, uns, euch, ihnen, Ihnen.",
      "hi": "डेटिव: der → dem, die → der, das → dem, बहुवचन → den। ein → einem, eine → einer। सर्वनाम: mir, dir, ihm, ihr, uns, euch, ihnen, Ihnen।"
    }
  },
  "deep_dive": {
    "en": "Verbs such as helfen, gefallen, gehören and danken always take the dative for the person: Ich helfe dir (not dich). Prepositions mit, bei, nach, aus, seit, von, zu always take dative.",
    "te": "helfen, gefallen, gehören, danken వంటి క్రియలు ఎల్లప్పుడూ వ్యక్తికి డేటివ్: Ich helfe dir (dich కాదు). mit, bei, nach, aus, seit, von, zu ఎల్లప్పుడూ డేటివ్.",
    "hi": "helfen, gefallen, gehören, danken जैसे क्रियाएँ व्यक्ति के लिए हमेशा dative लेती हैं: Ich helfe dir (dich नहीं)। mit, bei, nach, aus, seit, von, zu हमेशा dative लेते हैं।"
  },
  "common_mistakes": [
    {
      "wrong": "Ich helfe dich.",
      "right": "Ich helfe dir.",
      "why": {
        "en": "helfen takes the dative.",
        "te": "helfen కి డేటివ్.",
        "hi": "helfen के साथ dative।"
