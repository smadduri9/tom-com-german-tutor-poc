  "grammar_note": {
    "title": {
      "en": "Grammar: von, nach, aus",
      "te": "వ్యాకరణం: von, nach, aus",
      "hi": "व्याकरण: von, nach, aus"
    },
    "body": {
      "en": "Use nach for destinations (nach Frankfurt), von for the starting point (von Gleis drei), and aus for origin or \"out of\" (aus Indien). All three take dative.",
      "te": "గమ్యానికి nach (nach Frankfurt), ప్రారంభానికి von (von Gleis drei), మూలానికి aus (aus Indien). మూడూ డేటివ్.",
      "hi": "गंतव्य के लिए nach (nach Frankfurt), आरंभ के लिए von (von Gleis drei), मूल के लिए aus (aus Indien)। तीनों dative लेते हैं।"
    }
  },
  "deep_dive": {
    "en": "German trains are punctual most of the time, but delays happen. Listen for \"Verspätung\" in announcements and check the app (DB Navigator) for live times.",
    "te": "జర్మన్ రైళ్లు సాధారణంగా సమయానికి నడుస్తాయి, కానీ ఆలస్యాలు జరుగుతాయి. ప్రకటనల్లో \"Verspätung\" వినండి; ప్రత్యక్ష సమయాల కోసం యాప్ చూడండి.",
    "hi": "जर्मन ट्रेनें ज़्यादातर समय पर चलती हैं, पर देरी होती है। घोषणाओं में \"Verspätung\" सुनें और लाइव समय के लिए ऐप देखें।"
  },
  "common_mistakes": [
