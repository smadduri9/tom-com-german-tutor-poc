  "grammar_note": {
    "title": {
      "en": "Grammar: question word first",
      "te": "వ్యాకరణం: ప్రశ్న పదం ముందు",
      "hi": "व्याकरण: प्रश्न शब्द पहले"
    },
    "body": {
      "en": "In a W-question the question word comes first and the verb second: Wo wohnen Sie? (Where live you?). Wohin asks about movement to a place (nach Berlin); wo asks about place (in Berlin).",
      "te": "W-ప్రశ్నలో ప్రశ్న పదం మొదట, క్రియ రెండవ స్థానంలో: Wo wohnen Sie? wohin = కదలిక (nach Berlin), wo = స్థానం (in Berlin).",
      "hi": "W-प्रश्न में प्रश्न शब्द पहले, क्रिया दूसरे स्थान पर: Wo wohnen Sie? wohin = गति (nach Berlin), wo = स्थान (in Berlin)।"
    }
  },
  "deep_dive": {
    "en": "Woher and wohin both use \"von\" or \"nach\": Woher kommen Sie? Aus Indien. Wohin fahren Sie? Nach Berlin.",
    "te": "Woher మరియు wohin రెండూ: Woher kommen Sie? Aus Indien. Wohin fahren Sie? Nach Berlin.",
    "hi": "Woher और wohin दोनों: Woher kommen Sie? Aus Indien. Wohin fahren Sie? Nach Berlin।"
  },
  "common_mistakes": [
    {
      "wrong": "Wo gehen Sie?",
      "right": "Wohin gehen Sie?",
      "why": {
        "en": "Movement to a place uses wohin.",
        "te": "స్థలానికి కదలిక అంటే wohin.",
        "hi": "किसी जगह की ओर गति के लिए wohin।"
      }
    },
    {
      "wrong": "Was ist dein Name?",
      "right": "Wie heißen Sie?",
      "why": {
        "en": "Asking a name: Wie heißen Sie? (formal)",
        "te": "పేరు అడగడం: Wie heißen Sie? (గౌరవంగా)",
        "hi": "नाम पूछने के लिए: Wie heißen Sie? (औपचारिक)"
      }
    }
  ],
  "cultural_note": {
    "en": "At German counters people often ask \"Wann?\" and \"Wo?\" in short questions. Short, clear questions are polite here.",
    "te": "జర్మన్ కౌంటర్ల వద్ద చిన్న, స్పష్టమైన ప్రశ్నలు మర్యాదగా ఉంటాయి.",
    "hi": "जर्मन काउंटर पर छोटे, साफ़ प्रश्न विनम्र माने जाते हैं।"
  },
  "practice_tip": {
    "en": "Write one question for each W-word and answer it about yourself.",
    "te": "ప్రతి W-పదానికి ఒక ప్రశ్న రాసి మీ గురించి జవాబు రాయండి.",
    "hi": "हर W-शब्द पर एक प्रश्न लिखें और अपने बारे में उत्तर दें।"
  },
