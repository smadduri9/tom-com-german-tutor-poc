  "grammar_note": {
    "title": {
      "en": "Grammar: colours and adjective endings",
      "te": "వ్యాకరణం: రంగులు మరియు విశేషణ ముగింపులు",
      "hi": "व्याकरण: रंग और विशेषण के अंत"
    },
    "body": {
      "en": "After der, die or das, a colour adds -e or -en: der blaue Pullover. After ein, the colour takes -e for der and das words: ein blauer Pullover. Colours without an article stay plain: Das Hemd ist blau.",
      "te": "der, die, das తర్వాత రంగుకు -e లేదా -en: der blaue Pullover. ein తర్వాత: ein blauer Pullover. ఆర్టికల్ లేకుండా: Das Hemd ist blau.",
      "hi": "der, die, das के बाद रंग में -e या -en: der blaue Pullover। ein के बाद: ein blauer Pullover। बिना आर्टिकल: Das Hemd ist blau।"
    }
  },
  "deep_dive": {
    "en": "Clothing sizes in Germany follow letters (S, M, L) or numbers (38, 40). Trying on before buying is normal in shops.",
    "te": "జర్మనీలో దుస్తుల సైజులు అక్షరాలు (S, M, L) లేదా సంఖ్యలు (38, 40). కొనే ముందు ప్రయత్నించడం సాధారణం.",
    "hi": "जर्मनी में कपड़ों के साइज़ अक्षरों (S, M, L) या संख्याओं (38, 40) में होते हैं। खरीदने से पहले पहनकर देखना आम है।"
  },
  "common_mistakes": [
    {
      "wrong": "ein blau Hemd",
      "right": "ein blaues Hemd",
      "why": {
        "en": "After ein, a colour takes -es for das words.",
        "te": "ein తర్వాత రంగుకు das పదాలకు -es.",
        "hi": "ein के बाद das शब्दों के लिए -es।"
      }
    },
    {
      "wrong": "Das Hemd ist blaue.",
      "right": "Das Hemd ist blau.",
      "why": {
        "en": "After \"ist\", colours take no ending.",
        "te": "\"ist\" తర్వాత రంగుకు ముగింపు ఉండదు.",
        "hi": "\"ist\" के बाद रंग का अंत नहीं होता।"
      }
    }
  ],
  "cultural_note": {
    "en": "In German shops you may be asked to pay at the till. Bring a bag or pay for one; plastic bags cost money.",
    "te": "జర్మన్ దుకాణాల్లో క్యాష్ కౌంటర్ వద్ద చెల్లించాలి. సంచి తెచ్చుకోండి; ప్లాస్టిక్ సంచులకు డబ్బు తీసుకుంటారు.",
    "hi": "जर्मन दुकानों में काउंटर पर भुगतान करना होता है। थैला साथ रखें; प्लास्टिक थैले के पैसे लगते हैं।"
  },
  "practice_tip": {
    "en": "Name five clothes you are wearing today in German, with their colours.",
    "te": "ఈ రోజు మీరు వేసుకున్న ఐదు దుస్తులను రంగులతో జర్మన్‌లో చెప్పండి.",
    "hi": "आज आपने जो पाँच कपड़े पहने हैं उनके रंग के साथ जर्मन में बताएँ।"
  },
