  "grammar_note": {
    "title": {
      "en": "Grammar: am, um, im",
      "te": "వ్యాకరణం: am, um, im",
      "hi": "व्याकरण: am, um, im"
    },
    "body": {
      "en": "Use am with days (am Montag), um with clock times (um acht Uhr) and im with months and seasons (im Mai, im Sommer).",
      "te": "రోజులతో am (am Montag), గడియార సమయాలతో um (um acht Uhr), నెలలు, ఋతువులతో im (im Mai, im Sommer).",
      "hi": "दिनों के साथ am (am Montag), घड़ी के समय के साथ um (um acht Uhr), महीनों और ऋतुओं के साथ im (im Mai, im Sommer)।"
    }
  },
  "deep_dive": {
    "en": "Careful with \"halb\": halb neun means half an hour before nine, so 8:30, not 9:30. Official times use 24 hours: 16:30 is \"sechzehn Uhr dreißig\". \"Morgen\" means tomorrow; \"der Morgen\" means the morning.",
    "te": "\"halb\" జాగ్రత్త: halb neun అంటే తొమ్మిదికి అరగంట ముందు, అంటే 8:30, 9:30 కాదు. అధికారిక సమయాలు 24 గంటల్లో: 16:30 అంటే \"sechzehn Uhr dreißig\". \"morgen\" అంటే రేపు; \"der Morgen\" అంటే ఉదయం.",
    "hi": "\"halb\" से सावधान: halb neun का मतलब नौ से आधा घंटा पहले, यानी 8:30, 9:30 नहीं। आधिकारिक समय 24 घंटे में: 16:30 है \"sechzehn Uhr dreißig\"। \"morgen\" का मतलब कल (आने वाला); \"der Morgen\" का मतलब सुबह।"
  },
  "common_mistakes": [
    {
      "wrong": "halb neun = 9:30",
      "right": "halb neun = 8:30",
      "why": {
        "en": "halb counts toward the next hour.",
