  "grammar_note": {
    "title": {
      "en": "Grammar: mein or meine?",
      "te": "వ్యాకరణం: mein లేదా meine?",
      "hi": "व्याकरण: mein या meine?"
    },
    "body": {
      "en": "Use mein with der and das words (mein Vater, mein Kind). Use meine with die words and with plurals (meine Mutter, meine Eltern). The same works for dein / deine (your).",
      "te": "der, das పదాలతో mein (mein Vater, mein Kind). die పదాలు, బహువచనాలతో meine (meine Mutter, meine Eltern). dein / deine (నీ) కి కూడా ఇదే నియమం.",
      "hi": "der और das शब्दों के साथ mein (mein Vater, mein Kind)। die शब्दों और बहुवचन के साथ meine (meine Mutter, meine Eltern)। dein / deine (तुम्हारा) के लिए भी यही नियम है।"
    }
  },
  "deep_dive": {
    "en": "German has one word for many Indian relations: Onkel is any uncle, Tante any aunt, Cousin / Cousine any cousin. To be exact, add a description: der Bruder meiner Mutter (my mother’s brother).",
    "te": "జర్మన్‌లో చాలా భారతీయ బంధుత్వాలకు ఒకే పదం: Onkel అంటే ఏ మామయ్య/బాబాయ్ అయినా, Tante అంటే ఏ అత్త/పిన్ని అయినా. ఖచ్చితంగా చెప్పాలంటే వివరణ జోడించండి: der Bruder meiner Mutter (మా అమ్మ తమ్ముడు).",
    "hi": "जर्मन में कई भारतीय रिश्तों के लिए एक ही शब्द है: Onkel कोई भी चाचा/मामा, Tante कोई भी चाची/मौसी। सटीक कहने के लिए विवरण जोड़ें: der Bruder meiner Mutter (मेरी माँ का भाई)।"
  },
  "common_mistakes": [
    {
      "wrong": "mein Mutter",
      "right": "meine Mutter",
      "why": {
        "en": "Mutter is die, so meine.",
        "te": "Mutter అంటే die, కాబట్టి meine.",
        "hi": "Mutter die है, इसलिए meine।"
      }
    },
    {
